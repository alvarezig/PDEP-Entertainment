@startuml

class Productora {
  impuesto
  bandasRegistradas
  asistentesRegistrados
  ventas
  --
  registrarBanda(banda)
  registrarAsistente(asistente)
  registrarVenta(entrada)
  venderEntradaA(asistente, banda, fecha)
  precioConImpuesto(precioBase)
  recaudacion()
  presupuestoTotal()
  gananciaTotal()
  cantidadEntradasVendidas()
  ventasDe(banda)
  bandaMasPopular()
  bonificar(asistente)
  bonificarAsistentesVip()
}

class Asistente {
  abono
  dineroDisponible
  entradasCompradas
  --
  entradas()
  historial()
  cantidadEntradas()
  puedeComprar()
  esVip()
  comprarEntrada(entrada, productora)
  montoAPagar(entrada, productora)
  entradasDelAnioAnterior()
  entradasDelAnio(anio)
  bandasCompradas()
  bonificar()
}

class Entrada {
  banda
  fecha
  precioBase
  --
  precioPublico(productora)
  anio()
  esDe(unaBanda)
}

abstract class Banda {
  nombre
  canonBase
  --
  canon()
  gastoExtra()
  popularidad()
  presupuesto()
}

class BandaRock {
  solosDeGuitarra
  --
  agregarSoloDeGuitarra()
  gastoExtra()
  popularidad()
}

class BandaTrap {
  tieneHielo
  --
  popularidad()
  canon()
}

class BandaIndie {
  instrumentos
  --
  agregarInstrumento(instrumento)
  cantidadInstrumentos()
  gastoExtra()
  popularidad()
}

abstract class Abono {
  --
  porcentajeDescuento()
  aplicarDescuentoA(precio)
  esVip()
  bonificar()
}

class Fan {
  --
  porcentajeDescuento()
  esVip()
}

class Vip {
  descuento
  --
  porcentajeDescuento()
  esVip()
  bonificar()
}

class Date <<librería Wollok>>

Productora --> "*" Banda : conoce
Productora --> "*" Asistente : conoce
Productora --> "*" Entrada : conoce

Asistente --> "1" Abono : tiene
Asistente --> "*" Entrada : conoce

Entrada --> "1" Banda : conoce
Entrada --> "1" Date : conoce

BandaRock --|> Banda : hereda
BandaTrap --|> Banda : hereda
BandaIndie --|> Banda : hereda
Fan --|> Abono : hereda
Vip --|> Abono : hereda

Entrada ..> Productora : consulta impuesto
Asistente ..> Productora : registra venta
Productora ..> Asistente : delega compra
Productora ..> Banda : consulta presupuesto

Productora --> "*" Banda : conoce
Productora --> "*" Asistente : conoce
Productora --> "*" Entrada : conoce

Asistente --> "1" Abono : tiene
Asistente --> "*" Entrada : conoce

Entrada --> "1" Banda : conoce
Entrada --> "1" Date : conoce

@enduml
